# Copy to .env and fill in.

# Gemini, for the Day Briefing card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Console → Credentials → your OAuth 2.0 Web application client.
# The client needs http://localhost:3000/oauth/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
