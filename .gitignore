.env
tokens.json
node_modules/
.DS_Store

# SQLite in WAL mode writes tasks.db-wal and tasks.db-shm alongside the database, and both
# hold real task rows. One glob catches the database, the sidecars and any backup of it.
# The previous "tasks.db" + "tasks.db-*" pair could not match a dot, so the sidecars slipped
# through.
tasks.db*
tasks.json*
reminders.json

.playwright-cli/
.claude/
.impeccable/
.fuse_hidden*
*.log

# Per-user course-name table, filled in from the UI.
courses.json
config.json
