# Copy to .env and fill in.

# Gemini, for the Day Briefing card: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Console → Credentials → your OAuth 2.0 Web application client.
# The client needs http://localhost:3000/oauth/callback as an Authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Moodle (eLearn UC) calendar — read-only, one-way, nothing written back.
# In Moodle: Calendar → Export calendar → choose the events and time range →
# "Get URL for subscription". Paste that whole URL (it already carries your
# userid and authtoken) after the =. Leave empty to switch the feed off.
# It is a personal credential: .env is gitignored, and the server never sends
# this URL — only the parsed events — to the browser.
MOODLE_ICS_URL=
