# Optional. A normal install needs no .env: the Google client ships in oauth-client.json and
# your name, port and eLearn URL live in config.json (written by the installer and Settings).
# Anything set here wins over those.

# Your own Google OAuth client instead of the shared one (Desktop app type).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Moodle (eLearn UC) export URL. Settings → eLearn calendar is the easier place to put it.
# MOODLE_ICS_URL=

# PORT=3100
